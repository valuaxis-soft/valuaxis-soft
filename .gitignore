# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# IDE
.idea/
.vscode/
*.cache
.eslintcache

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads content (keep directory)
public/uploads/*
# Local storage driver: cover, header and Datos generales images
/public/organizaciones/
!public/uploads/.gitkeep

# AI agent artifacts
/.agents/
/.atl/
/AGENTS.md
/CLAUDE.md
/skills-lock.json

# temporary / scratchpad
/tmp/
/.tmp/
/src-tree.txt
/src-tree-clean.txt

# binary artifacts at root
/*.zip
/valuo-datos-preview.png
# Fase 0: volcado de los Excel del despacho (datos del cliente)
/docs/fase0/dump/

