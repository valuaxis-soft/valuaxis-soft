{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.ts",
    "prisma/seed.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "tests/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/security/guards/**",
    "src/features/auth/rules/subscription-access.rules.ts",
    "src/lib/auth/current-session.ts",
    "src/features/auth/permissions.ts",
    "src/features/valuations/policies/valuation-access.policy.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "warn"
  },
  "ignoreDependencies": [
    "tw-animate-css",
    "shadcn",
    "tailwindcss"
  ],
  "ignoreIssues": {
    "src/components/ui/**": [
      "exports",
      "types"
    ]
  }
}
