{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.ts",
    "prisma/seed.ts",
    "tests/integration/**/*.integration.ts",
    "tests/integration/**/*.helper.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "tests/**/*.{ts,tsx}"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "warn"
  },
  "ignoreDependencies": [
    "tw-animate-css",
    "shadcn",
    "tailwindcss"
  ],
  "ignoreIssues": {
    "src/components/ui/**": [
      "exports",
      "types"
    ]
  }
}
