  BSinLimite               Boolean   @default(false) @map("BSinLimite")
  ILimitePersonalizado     BigInt?   @map("ILimitePersonalizado")
  SPeriodoLimite           String?   @map("SPeriodoLimite") @db.VarChar(40)
  SMotivo                  String    @map("SMotivo") @db.VarChar(1000)
  DFechaInicio             DateTime  @default(now()) @map("DFechaInicio") @db.Timestamptz(3)
  DFechaFin                DateTime? @map("DFechaFin") @db.Timestamptz(3)
  BActiva                  Boolean   @default(true) @map("BActiva")
  DFechaCreacion           DateTime  @default(now()) @map("DFechaCreacion") @db.Timestamptz(3)
  DFechaModificacion       DateTime  @updatedAt @map("DFechaModificacion") @db.Timestamptz(3)

  organizacion       Organizacion  @relation(fields: [IdOrganizacion], references: [IdOrganizacion], onDelete: Cascade, onUpdate: Cascade)
  funcionalidad      Funcionalidad @relation(fields: [IdFuncionalidad], references: [IdFuncionalidad], onDelete: Restrict, onUpdate: Cascade)
  usuarioAutorizador Usuario?      @relation("ConcesionUsuarioAutorizador", fields: [IdUsuarioAutorizador], references: [IdUsuario], onDelete: SetNull, onUpdate: Cascade)

  @@index([IdOrganizacion])
  @@index([IdFuncionalidad])
  @@index([BActiva])
  @@map("devpware_concesiones_funcionalidades")
}
