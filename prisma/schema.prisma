generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EstadoOrganizacion {
  IdEstadoOrganizacion Int      @id @default(autoincrement()) @map("IdEstadoOrganizacion")
  SClave               String   @unique @map("SClave") @db.VarChar(64)
  SNombre              String   @map("SNombre") @db.VarChar(160)
  SDescripcion         String?  @map("SDescripcion")
  BPermiteOperacion    Boolean  @map("BPermiteOperacion")
  BActivo              Boolean  @default(true) @map("BActivo")
  IOrden               Int      @default(0) @map("IOrden")
  DFechaCreacion       DateTime @default(now()) @map("DFechaCreacion")
  DFechaModificacion   DateTime @updatedAt @map("DFechaModificacion")

  organizaciones Organizacion[]

  @@map("devpware_estados_organizaciones")
}

model EstadoUsuario {
  IdEstadoUsuario    Int      @id @default(autoincrement()) @map("IdEstadoUsuario")
  SClave             String   @unique @map("SClave") @db.VarChar(64)
  SNombre            String   @map("SNombre") @db.VarChar(160)
  SDescripcion       String?  @map("SDescripcion")
  BPermiteAcceso     Boolean  @map("BPermiteAcceso")
  BActivo            Boolean  @default(true) @map("BActivo")
  IOrden             Int      @default(0) @map("IOrden")
  DFechaCreacion     DateTime @default(now()) @map("DFechaCreacion")
  DFechaModificacion DateTime @updatedAt @map("DFechaModificacion")

  usuarios Usuario[]

  @@map("devpware_estados_usuarios")
}

model EstadoAvaluo {
  IdEstadoAvaluo     Int      @id @default(autoincrement()) @map("IdEstadoAvaluo")
  SClave             String   @unique @map("SClave") @db.VarChar(64)
  SNombre            String   @map("SNombre") @db.VarChar(160)
  SDescripcion       String?  @map("SDescripcion")
  BEsInicial         Boolean  @map("BEsInicial")
  BEsFinal           Boolean  @map("BEsFinal")
  BPermiteEdicion    Boolean  @map("BPermiteEdicion")
  BBloqueaAvaluo     Boolean  @map("BBloqueaAvaluo")
  BActivo            Boolean  @default(true) @map("BActivo")
  IOrden             Int      @default(0) @map("IOrden")
  DFechaCreacion     DateTime @default(now()) @map("DFechaCreacion")
  DFechaModificacion DateTime @updatedAt @map("DFechaModificacion")

  avaluos             Avaluo[]
  historialesAnterior EstadoAvaluoHistorial[]  @relation("EstadoAvaluoAnterior")
  historialesNuevo    EstadoAvaluoHistorial[]  @relation("EstadoAvaluoNuevo")
  transicionesOrigen  TransicionEstadoAvaluo[] @relation("TransicionEstadoOrigen")
  transicionesDestino TransicionEstadoAvaluo[] @relation("TransicionEstadoDestino")

  @@map("devpware_estados_avaluos")
}

model EstadoVersionAvaluo {
  IdEstadoVersionAvaluo Int      @id @default(autoincrement()) @map("IdEstadoVersionAvaluo")
  SClave                String   @unique @map("SClave") @db.VarChar(64)
  SNombre               String   @map("SNombre") @db.VarChar(160)
  SDescripcion          String?  @map("SDescripcion")
  BPermiteEdicion       Boolean  @map("BPermiteEdicion")
  BEsFinal              Boolean  @map("BEsFinal")
  BActivo               Boolean  @default(true) @map("BActivo")
  IOrden                Int      @default(0) @map("IOrden")
  DFechaCreacion        DateTime @default(now()) @map("DFechaCreacion")
  DFechaModificacion    DateTime @updatedAt @map("DFechaModificacion")

  versionesAvaluos VersionAvaluo[]

  @@map("devpware_estados_versiones_avaluos")
}

model TipoAvaluo {
  IdTipoAvaluo       Int      @id @default(autoincrement()) @map("IdTipoAvaluo")
  SClave             String   @unique @map("SClave") @db.VarChar(64)
  SNombre            String   @map("SNombre") @db.VarChar(160)
  SDescripcion       String?  @map("SDescripcion")
  BActivo            Boolean  @default(true) @map("BActivo")
  IOrden             Int      @default(0) @map("IOrden")
  DFechaCreacion     DateTime @default(now()) @map("DFechaCreacion")
  DFechaModificacion DateTime @updatedAt @map("DFechaModificacion")

  avaluos           Avaluo[]
  plantillasAvaluos PlantillaAvaluo[]

  @@map("devpware_tipos_avaluos")
}

model TipoInmueble {
  IdTipoInmueble       Int      @id @default(autoincrement()) @map("IdTipoInmueble")
  SClave               String   @unique @map("SClave") @db.VarChar(64)
  SNombre              String   @map("SNombre") @db.VarChar(160)
  SDescripcion         String?  @map("SDescripcion")
  BPermiteTerreno      Boolean  @map("BPermiteTerreno")
  BPermiteConstruccion Boolean  @map("BPermiteConstruccion")
  BActivo              Boolean  @default(true) @map("BActivo")
  IOrden               Int      @default(0) @map("IOrden")
  DFechaCreacion       DateTime @default(now()) @map("DFechaCreacion")
  DFechaModificacion   DateTime @updatedAt @map("DFechaModificacion")

  avaluos     Avaluo[]
  propiedades Propiedad[]

  @@map("devpware_tipos_inmuebles")
}

model TipoOperacion {
  IdTipoOperacion    Int      @id @default(autoincrement()) @map("IdTipoOperacion")
  SClave             String   @unique @map("SClave") @db.VarChar(64)
  SNombre            String   @map("SNombre") @db.VarChar(160)
  SDescripcion       String?  @map("SDescripcion")
  BActivo            Boolean  @default(true) @map("BActivo")
  IOrden             Int      @default(0) @map("IOrden")
  DFechaCreacion     DateTime @default(now()) @map("DFechaCreacion")
  DFechaModificacion DateTime @updatedAt @map("DFechaModificacion")

  avaluos       Avaluo[]
  publicaciones PublicacionPropiedad[]

  @@map("devpware_tipos_operaciones")
}

model TipoDato {
  IdTipoDato         Int      @id @default(autoincrement()) @map("IdTipoDato")
  SClave             String   @unique @map("SClave") @db.VarChar(64)
  SNombre            String   @map("SNombre") @db.VarChar(160)
  SDescripcion       String?  @map("SDescripcion")
  BActivo            Boolean  @default(true) @map("BActivo")
  IOrden             Int      @default(0) @map("IOrden")
  DFechaCreacion     DateTime @default(now()) @map("DFechaCreacion")
  DFechaModificacion DateTime @updatedAt @map("DFechaModificacion")

  nodosPlantillas      NodoPlantilla[]
  nodosDocumentos      NodoDocumento[]
  valoresDocumentos    ValorNodoDocumento[]
  camposPersonalizados CampoPersonalizado[]
  columnasTablas       ColumnaTablaDocumento[]

  @@map("devpware_tipos_datos")
}

model TipoNodoDocumento {
  IdTipoNodoDocumento Int      @id @default(autoincrement()) @map("IdTipoNodoDocumento")
  SClave              String   @unique @map("SClave") @db.VarChar(64)
  SNombre             String   @map("SNombre") @db.VarChar(160)
  SDescripcion        String?  @map("SDescripcion")
  BActivo             Boolean  @default(true) @map("BActivo")
  IOrden              Int      @default(0) @map("IOrden")
  DFechaCreacion      DateTime @default(now()) @map("DFechaCreacion")
  DFechaModificacion  DateTime @updatedAt @map("DFechaModificacion")

  nodosPlantillas NodoPlantilla[]
  nodosDocumentos NodoDocumento[]

  @@map("devpware_tipos_nodos_documentos")
}

model TipoColumna {
  IdTipoColumna      Int      @id @default(autoincrement()) @map("IdTipoColumna")
  SClave             String   @unique @map("SClave") @db.VarChar(64)
  SNombre            String   @map("SNombre") @db.VarChar(160)
  SDescripcion       String?  @map("SDescripcion")
  BActivo            Boolean  @default(true) @map("BActivo")
  IOrden             Int      @default(0) @map("IOrden")
  DFechaCreacion     DateTime @default(now()) @map("DFechaCreacion")
  DFechaModificacion DateTime @updatedAt @map("DFechaModificacion")

  columnasTablas ColumnaTablaDocumento[]

  @@map("devpware_tipos_columnas")
}

model TipoArchivo {
  IdTipoArchivo      Int      @id @default(autoincrement()) @map("IdTipoArchivo")
  SClave             String   @unique @map("SClave") @db.VarChar(64)
  SNombre            String   @map("SNombre") @db.VarChar(160)
  SDescripcion       String?  @map("SDescripcion")
  BActivo            Boolean  @default(true) @map("BActivo")
  IOrden             Int      @default(0) @map("IOrden")
  DFechaCreacion     DateTime @default(now()) @map("DFechaCreacion")
  DFechaModificacion DateTime @updatedAt @map("DFechaModificacion")

  archivos Archivo[]

  @@map("devpware_tipos_archivos")
}

model OrigenDato {
  IdOrigenDato       Int      @id @default(autoincrement()) @map("IdOrigenDato")
  SClave             String   @unique @map("SClave") @db.VarChar(64)
  SNombre            String   @map("SNombre") @db.VarChar(160)
  SDescripcion       String?  @map("SDescripcion")
  BActivo            Boolean  @default(true) @map("BActivo")
  IOrden             Int      @default(0) @map("IOrden")
  DFechaCreacion     DateTime @default(now()) @map("DFechaCreacion")
  DFechaModificacion DateTime @updatedAt @map("DFechaModificacion")

  valoresDocumentos           ValorNodoDocumento[]
  valoresCamposPersonalizados ValorCampoPersonalizado[]
  celdasTablas                CeldaTablaDocumento[]
  direccionesPropiedades      DireccionPropiedad[]
  factoresHomologacion        FactorHomologacion[]
  geocodificaciones           Geocodificacion[]

  @@map("devpware_origenes_datos")
}

model EstadoValidacion {
  IdEstadoValidacion Int      @id @default(autoincrement()) @map("IdEstadoValidacion")
  SClave             String   @unique @map("SClave") @db.VarChar(64)
  SNombre            String   @map("SNombre") @db.VarChar(160)
  SDescripcion       String?  @map("SDescripcion")
  BActivo            Boolean  @default(true) @map("BActivo")
  IOrden             Int      @default(0) @map("IOrden")
  DFechaCreacion     DateTime @default(now()) @map("DFechaCreacion")
  DFechaModificacion DateTime @updatedAt @map("DFechaModificacion")

  @@map("devpware_estados_validaciones")
}

model Organizacion {
  IdOrganizacion        Int       @id @default(autoincrement()) @map("IdOrganizacion")
  UIdentificadorPublico String    @unique @default(dbgenerated("gen_random_uuid()")) @map("UIdentificadorPublico") @db.Uuid
  IdEstadoOrganizacion  Int       @map("IdEstadoOrganizacion")
  IdUsuarioPropietario  Int?      @map("IdUsuarioPropietario")
  SNombre               String    @map("SNombre") @db.VarChar(180)
  SSlug                 String    @unique @map("SSlug") @db.VarChar(180)
  STipoAmbito           String    @map("STipoAmbito") @db.VarChar(20)
  SRazonSocial          String?   @map("SRazonSocial") @db.VarChar(220)
  SRFC                  String?   @map("SRFC") @db.VarChar(20)
  SCorreo               String?   @map("SCorreo") @db.VarChar(180)
  STelefono             String?   @map("STelefono") @db.VarChar(30)
  BActivo               Boolean   @default(true) @map("BActivo")
  DFechaCreacion        DateTime  @default(now()) @map("DFechaCreacion")
  DFechaModificacion    DateTime  @updatedAt @map("DFechaModificacion")
  DFechaEliminacion     DateTime? @map("DFechaEliminacion")

  estadoOrganizacion         EstadoOrganizacion       @relation(fields: [IdEstadoOrganizacion], references: [IdEstadoOrganizacion], onDelete: Restrict, onUpdate: Cascade)
  usuarioPropietario         Usuario?                 @relation("OrganizacionUsuarioPropietario", fields: [IdUsuarioPropietario], references: [IdUsuario], onDelete: Restrict, onUpdate: Cascade)
  miembros                   MiembroOrganizacion[]
  sesiones                   Sesion[]
  avaluos                    Avaluo[]
  seriesFolios               SerieFolioOrganizacion[]
  etiquetas                  Etiqueta[]
  plantillasAvaluos          PlantillaAvaluo[]
  camposPersonalizados       CampoPersonalizado[]
  archivos                   Archivo[]                @relation("ArchivoOrganizacion")
  cargasArchivos             CargaArchivo[]           @relation("CargaArchivoOrganizacion")
  propiedades                Propiedad[]
  busquedasComparables       BusquedaComparable[]
  geocodificaciones          Geocodificacion[]
  auditorias                 Auditoria[]
  trabajos                   Trabajo[]
  importaciones              Importacion[]
  suscripciones              Suscripcion[]
  concesionesFuncionalidades ConcesionFuncionalidad[]

  @@index([IdEstadoOrganizacion])
  @@index([IdUsuarioPropietario])
  @@index([STipoAmbito])
  @@index([BActivo])
  @@index([DFechaEliminacion])
  @@map("devpware_organizaciones")
}

model SerieFolioOrganizacion {
  IdSerieFolioOrganizacion Int      @id @default(autoincrement()) @map("IdSerieFolioOrganizacion")
  IdOrganizacion           Int      @map("IdOrganizacion")
  SPrefijo                 String   @default("VLO") @map("SPrefijo") @db.VarChar(20)
  IUltimoConsecutivo       Int      @default(0) @map("IUltimoConsecutivo")
  BActivo                  Boolean  @default(true) @map("BActivo")
  DFechaCreacion           DateTime @default(now()) @map("DFechaCreacion") @db.Timestamp(3)
  DFechaModificacion       DateTime @default(now()) @updatedAt @map("DFechaModificacion") @db.Timestamp(3)

  organizacion Organizacion @relation(fields: [IdOrganizacion], references: [IdOrganizacion], onDelete: Cascade, onUpdate: Cascade)

  @@unique([IdOrganizacion, SPrefijo], map: "devpware_series_folios_organizaciones_org_prefijo_key")
  @@index([IdOrganizacion])
  @@index([BActivo])
  @@map("devpware_series_folios_organizaciones")
}

model Usuario {
  IdUsuario                Int       @id @default(autoincrement()) @map("IdUsuario")
  UIdentificadorPublico    String    @unique @default(dbgenerated("gen_random_uuid()")) @map("UIdentificadorPublico") @db.Uuid
  IdEstadoUsuario          Int       @map("IdEstadoUsuario")
  SNombre                  String    @map("SNombre") @db.VarChar(120)
  SApellidoPaterno         String?   @map("SApellidoPaterno") @db.VarChar(120)
  SApellidoMaterno         String?   @map("SApellidoMaterno") @db.VarChar(120)
  SCorreo                  String    @unique @map("SCorreo") @db.VarChar(180)
  SContrasenaHash          String?   @map("SContrasenaHash") @db.VarChar(255)
  STelefono                String?   @map("STelefono") @db.VarChar(30)
  SImagenPerfil            String?   @map("SImagenPerfil") @db.VarChar(500)
  BActivo                  Boolean   @default(true) @map("BActivo")
  DFechaUltimoAcceso       DateTime? @map("DFechaUltimoAcceso")
  DFechaCreacion           DateTime  @default(now()) @map("DFechaCreacion")
  DFechaModificacion       DateTime  @updatedAt @map("DFechaModificacion")
  DFechaEliminacion        DateTime? @map("DFechaEliminacion")
  BCorreoVerificado        Boolean   @default(false) @map("BCorreoVerificado")
  DFechaVerificacionCorreo DateTime? @map("DFechaVerificacionCorreo") @db.Timestamptz(3)
  DFechaCambioContrasena   DateTime? @map("DFechaCambioContrasena") @db.Timestamptz(3)
  IReintentosConsecutivos  Int       @default(0) @map("IReintentosConsecutivos")
  DFechaBloqueoTemporal    DateTime? @map("DFechaBloqueoTemporal") @db.Timestamptz(3)

  estadoUsuario                EstadoUsuario                 @relation(fields: [IdEstadoUsuario], references: [IdEstadoUsuario], onDelete: Restrict, onUpdate: Cascade)
  identidades                  IdentidadUsuario[]
  tokensVerificacionCorreo     TokenVerificacionCorreo[]
  tokensRecuperacionContrasena TokenRecuperacionContrasena[]
  solicitudesOAuth             SolicitudOAuth[]
  suscripcionesAlta            Suscripcion[]                 @relation("SuscripcionUsuarioAlta")
  concesionesAutorizadas       ConcesionFuncionalidad[]      @relation("ConcesionUsuarioAutorizador")
  miembros                     MiembroOrganizacion[]
  organizacionesPropietarias   Organizacion[]                  @relation("OrganizacionUsuarioPropietario")
  sesiones                     Sesion[]
  intentos                     IntentoAcceso[]
  avaluosCreados               Avaluo[]                      @relation("AvaluoUsuarioCreador")
  avaluosResponsable           Avaluo[]                      @relation("AvaluoUsuarioResponsable")
  usuariosAvaluos              UsuarioAvaluo[]
  versionesCreadas             VersionAvaluo[]               @relation("VersionAvaluoUsuarioCreador")
  versionesFinalizadas         VersionAvaluo[]               @relation("VersionAvaluoUsuarioFinalizador")
  historialesEstado            EstadoAvaluoHistorial[]
  etiquetasAsignadas           EtiquetaAvaluo[]
  reaperturas                  ReaperturaAvaluo[]
  versionesPlantillas          VersionPlantilla[]
  ejecucionesSobrescritas      EjecucionCalculo[]
  archivosCargados             Archivo[]                     @relation("ArchivoUsuarioCarga")
  cargasArchivos               CargaArchivo[]                @relation("CargaArchivoUsuario")
  conclusionesValuador         ConclusionAvaluo[]            @relation("ConclusionUsuarioValuador")
  direccionesConfirmadas       DireccionPropiedad[]          @relation("DireccionUsuarioConfirmacion")
  historialesUbicaciones       HistorialUbicacionPropiedad[]
  comparablesSeleccionados     ComparableAvaluo[]            @relation("ComparableUsuarioSeleccion")
  historialesUsoComparables    HistorialUsoComparable[]
  busquedasComparables         BusquedaComparable[]
  geocodificaciones            Geocodificacion[]
  capturasMapas                CapturaMapa[]
  snapshotsGenerados           SnapshotVersionAvaluo[]       @relation("SnapshotUsuarioGeneracion")
  auditorias                   Auditoria[]
  exportacionesAvaluos         ExportacionAvaluo[]
  bloqueosVersiones            BloqueoVersionAvaluo[]
  trabajosSolicitados          Trabajo[]                     @relation("TrabajoUsuarioSolicitud")
  eventosTrabajos              EventoTrabajo[]
  importaciones                Importacion[]
  eventosImportaciones         EventoImportacion[]

  @@index([IdEstadoUsuario])
  @@index([BActivo])
  @@index([DFechaEliminacion])
  @@map("devpware_usuarios")
}

model Rol {
  IdRol              Int      @id @default(autoincrement()) @map("IdRol")
  SClave             String   @unique @map("SClave") @db.VarChar(80)
  SNombre            String   @map("SNombre") @db.VarChar(160)
  SDescripcion       String?  @map("SDescripcion") @db.VarChar(500)
  BEsSistema         Boolean  @default(false) @map("BEsSistema")
  BActivo            Boolean  @default(true) @map("BActivo")
  DFechaCreacion     DateTime @default(now()) @map("DFechaCreacion") @db.Timestamptz(3)
  DFechaModificacion DateTime @updatedAt @map("DFechaModificacion") @db.Timestamptz(3)

  permisos        PermisoRol[]
  miembros        MiembroOrganizacion[]
  usuariosAvaluos UsuarioAvaluo[]

  @@map("devpware_roles")
}

model Permiso {
  IdPermiso          Int      @id @default(autoincrement()) @map("IdPermiso")
  SClave             String   @unique @map("SClave") @db.VarChar(100)
  SNombre            String   @map("SNombre") @db.VarChar(180)
  SDescripcion       String?  @map("SDescripcion") @db.VarChar(500)
  BActivo            Boolean  @default(true) @map("BActivo")
  DFechaCreacion     DateTime @default(now()) @map("DFechaCreacion") @db.Timestamptz(3)
  DFechaModificacion DateTime @updatedAt @map("DFechaModificacion") @db.Timestamptz(3)

  roles                    PermisoRol[]
  transicionesEstadoAvaluo TransicionEstadoAvaluo[]

  @@map("devpware_permisos")
}

model PermisoRol {
  IdPermisoRol   Int      @id @default(autoincrement()) @map("IdPermisoRol")
  IdRol          Int      @map("IdRol")
  IdPermiso      Int      @map("IdPermiso")
  DFechaCreacion DateTime @default(now()) @map("DFechaCreacion") @db.Timestamptz(3)

  rol     Rol     @relation(fields: [IdRol], references: [IdRol], onDelete: Cascade, onUpdate: Cascade)
  permiso Permiso @relation(fields: [IdPermiso], references: [IdPermiso], onDelete: Cascade, onUpdate: Cascade)

  @@unique([IdRol, IdPermiso])
  @@index([IdRol])
  @@index([IdPermiso])
  @@map("devpware_permisos_roles")
}

model MiembroOrganizacion {
  IdMiembroOrganizacion Int      @id @default(autoincrement()) @map("IdMiembroOrganizacion")
  IdOrganizacion        Int      @map("IdOrganizacion")
  IdUsuario             Int      @map("IdUsuario")
  IdRol                 Int      @map("IdRol")
  BActivo               Boolean  @default(true) @map("BActivo")
  DFechaIngreso         DateTime @default(now()) @map("DFechaIngreso") @db.Timestamptz(3)
  DFechaCreacion        DateTime @default(now()) @map("DFechaCreacion") @db.Timestamptz(3)
  DFechaModificacion    DateTime @updatedAt @map("DFechaModificacion") @db.Timestamptz(3)

  organizacion Organizacion @relation(fields: [IdOrganizacion], references: [IdOrganizacion], onDelete: Restrict, onUpdate: Cascade)
  usuario      Usuario      @relation(fields: [IdUsuario], references: [IdUsuario], onDelete: Restrict, onUpdate: Cascade)
  rol          Rol          @relation(fields: [IdRol], references: [IdRol], onDelete: Restrict, onUpdate: Cascade)

  @@unique([IdOrganizacion, IdUsuario])
  @@index([IdOrganizacion])
  @@index([IdUsuario])
  @@index([IdRol])
  @@index([BActivo])
  @@map("devpware_miembros_organizaciones")
}

model Sesion {
  IdSesion                  Int       @id @default(autoincrement()) @map("IdSesion")
  IdUsuario                 Int       @map("IdUsuario")
  IdOrganizacion            Int       @map("IdOrganizacion")
  STokenHash                String    @unique @map("STokenHash") @db.VarChar(255)
  SDireccionIP              String?   @map("SDireccionIP") @db.VarChar(64)
  SAgenteUsuario            String?   @map("SAgenteUsuario")
  BRevocada                 Boolean   @default(false) @map("BRevocada")
  DFechaCreacion            DateTime  @default(now()) @map("DFechaCreacion") @db.Timestamptz(3)
  DFechaExpiracion          DateTime  @map("DFechaExpiracion") @db.Timestamptz(3)
  DFechaRevocacion          DateTime? @map("DFechaRevocacion") @db.Timestamptz(3)
  IdIdentidadUsuario        BigInt?   @map("IdIdentidadUsuario")
  STokenRenovacionHash      String?   @map("STokenRenovacionHash") @db.VarChar(255)
  SIdentificadorDispositivo String?   @map("SIdentificadorDispositivo") @db.VarChar(180)
  SNombreDispositivo        String?   @map("SNombreDispositivo") @db.VarChar(220)
  DFechaUltimaActividad     DateTime? @map("DFechaUltimaActividad") @db.Timestamptz(3)
  DFechaRotacion            DateTime? @map("DFechaRotacion") @db.Timestamptz(3)

  usuario      Usuario           @relation(fields: [IdUsuario], references: [IdUsuario], onDelete: Cascade, onUpdate: Cascade)
  organizacion Organizacion      @relation(fields: [IdOrganizacion], references: [IdOrganizacion], onDelete: Cascade, onUpdate: Cascade)
  identidad    IdentidadUsuario? @relation(fields: [IdIdentidadUsuario], references: [IdIdentidadUsuario], onDelete: SetNull, onUpdate: Cascade)

  @@index([IdUsuario])
  @@index([IdOrganizacion])
  @@index([BRevocada])
  @@index([DFechaExpiracion])
  @@map("devpware_sesiones")
}

model IntentoAcceso {
  IdIntentoAcceso  BigInt   @id @default(autoincrement()) @map("IdIntentoAcceso")
  IdUsuario        Int?     @map("IdUsuario")
  SCorreoIntentado String   @map("SCorreoIntentado") @db.VarChar(180)
  SDireccionIP     String?  @map("SDireccionIP") @db.VarChar(64)
  BExitoso         Boolean  @default(false) @map("BExitoso")
  SMotivoFallo     String?  @map("SMotivoFallo") @db.VarChar(500)
