# Desarrollo local. Producción usa /opt/apps/valuos/secrets/production.env en el servidor.

# Base local de compose.dev.yml
DATABASE_URL="postgresql://valuaxis:valuaxis@localhost:5432/valuaxis_dev?schema=public"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# Correo. development: no envía, los registra en consola. resend: Resend (producción). ses: Amazon SES (alternativa).
EMAIL_PROVIDER="development"
# Remitente y respuestas para cualquier proveedor. En producción: no-reply@valuaxissoft.com y contacto@valuaxissoft.com.
# Ver docs/OPERACION.md, sección 12.
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME=""
EMAIL_REPLY_TO=""
# Llave de Resend solo de envío, restringida a valuaxissoft.com. Obligatoria si EMAIL_PROVIDER="resend".
RESEND_API_KEY=""
# Destinatario de pnpm email:test.
TEST_EMAIL_TO=""
# Solo para SES. Si EMAIL_FROM_ADDRESS está vacío, el remitente sale de SES_FROM_EMAIL.
SES_FROM_EMAIL=""
SES_FROM_NAME=""
AWS_SES_REGION=""
AWS_SES_ACCESS_KEY_ID=""
AWS_SES_SECRET_ACCESS_KEY=""

# local: escribe en public/ (solo desarrollo). s3: bucket privado con URLs firmadas.
STORAGE_DRIVER="local"
MAX_UPLOAD_SIZE_MB="10"
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_S3_ENDPOINT=""
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""

# Compatibilidad temporal con la configuración AWS anterior durante la migración.
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Google OAuth. El callback debe ser APP_URL + /api/auth/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Google Maps (opcional): llave de navegador para el mapa interactivo (sección Croquis del editor y demostración).
# Variable de runtime, sin NEXT_PUBLIC_. Restringida por referente (https://valuaxissoft.com/*) y solo a Maps JavaScript API.
# Sin ella, el panel avisa que los mapas no están configurados. Ver docs/OPERACION.md, sección 7.
GOOGLE_MAPS_API_KEY=""
# Llave del servidor para Geocoding API y Maps Static API (búsqueda de direcciones y croquis). Restringida por IP, nunca por referente.
# Sin ella, el servidor usa GOOGLE_MAPS_API_KEY (que entonces debe permitir esas APIs sin restricción de referente).
GOOGLE_MAPS_SERVER_KEY=""

# Solo para pnpm auth:create-admin. Bórralas después de crear al administrador.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME=""
INITIAL_ORGANIZATION_NAME=""
INITIAL_ADMIN_EMAIL_VERIFIED="false"

# Chromium para generar el dictamen en PDF en el servidor. La imagen de producción usa /usr/bin/chromium.
# En Mac: "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
CHROMIUM_PATH=""
# Dirección con que ese Chromium abre la app; por omisión http://127.0.0.1:$PORT.
INTERNAL_APP_URL=""

# Cobro con Stripe (opcional). Sin STRIPE_SECRET_KEY la app funciona igual y la página
# "Plan y facturación" avisa que los pagos no están habilitados. Ver docs/COBRO.md.
# En producción usa una clave restringida (rk_live_...) con los permisos de docs/COBRO.md.
STRIPE_SECRET_KEY=""
# Secreto de firma del endpoint /api/stripe/webhook (whsec_...). Sin él, el webhook rechaza todo.
STRIPE_WEBHOOK_SECRET=""
# Configuración propia del portal de clientes (bpc_...); la imprime pnpm stripe:sync.
STRIPE_PORTAL_CONFIGURATION=""
# No se usa: el pago es en la página de Stripe (Checkout por redirección), sin Stripe.js en el navegador.
# STRIPE_PUBLISHABLE_KEY=""

# Facturación CFDI con Facturapi (opcional). Sin FACTURAPI_KEY no se emite ninguna factura y la
# página "Plan y facturación" avisa que la facturación automática no está habilitada. Ver docs/COBRO.md.
# Llave secreta de la organización emisora en Facturapi: sk_test_... (pruebas) o sk_live_... (timbra ante el SAT).
FACTURAPI_KEY=""
# Solo pruebas y revisión en local: un Facturapi falso. Vacío usa https://www.facturapi.io/v2.
FACTURAPI_BASE_URL=""
# Clave de producto o servicio (c_ClaveProdServ) y de unidad (c_ClaveUnidad) del concepto.
# Vacías usan 81112106 (proveedores de servicios de aplicación) y E48 (unidad de servicio).
# Las confirma el contador del cliente.
INVOICE_PRODUCT_KEY=""
INVOICE_UNIT_KEY=""

# Asistencia con IA (opcional): "Pegar anuncio" y "Redactar borrador". Sin ANTHROPIC_API_KEY la app
# funciona igual, los botones no aparecen y las rutas responden "no habilitado". Ver docs/IA.md.
ANTHROPIC_API_KEY=""
# Modelos; vacíos usan los predeterminados (claude-haiku-4-5 para extraer, claude-opus-5-5 para redactar).
AI_EXTRACTION_MODEL=""
AI_DRAFTING_MODEL=""
# "Buscar con IA en la web" dentro de "Buscar comparables": "true" la enciende (además de ANTHROPIC_API_KEY).
# Apagada por omisión: cada búsqueda usa la búsqueda web del proveedor y cuesta más que las otras ayudas.
# Apagada o sin llave, la opción aparece deshabilitada con su aviso. Ver docs/IA.md y docs/OPERACION.md §13.
AI_COMPARABLE_SEARCH_ENABLED=""
# Modelo de esa búsqueda; vacío usa claude-opus-5-5.
AI_SEARCH_MODEL=""

# Acreditación profesional (opcional): llave del HMAC con que se guarda la CURP (mínimo 32 caracteres,
# p. ej. `openssl rand -hex 32`). Sin ella se guarda un SHA-256 simple. No cambiarla una vez puesta. Ver docs/ACREDITACION.md.
ACCREDITATION_HASH_SECRET=""

# Operador de la plataforma (opcional): correos separados por comas, sin distinguir mayúsculas. Solo ellos abren
# /operador/usuarios, el registro de todas las personas registradas (sin el contenido de sus avalúos).
# Vacío: nadie es operador. Ver docs/AUTHORIZATION.md y docs/OPERACION.md §14.
OPERATOR_EMAILS=""
# Verificación del teléfono con un código por SMS o WhatsApp (Twilio Verify, opcional). Sin las tres
# variables, «Mi cuenta» avisa que todavía no está habilitada y nada pide el teléfono. Ver docs/OPERACION.md §15.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
# "true": para crear un avalúo hace falta el teléfono verificado. Sin las llaves de Twilio se ignora.
PHONE_VERIFICATION_REQUIRED="false"
# Solo pruebas en local: dirección de un servidor falso en lugar de la API de Twilio. En producción se ignora.
TWILIO_API_BASE_URL=""

# Formato de los avalúos (src/features/valuations/services/layout-refresh.ts). "all" (o vacío): al abrir un
# avalúo no concluido toma los cambios de formato que le falten (etapa de afinación). "new": solo los avalúos
# creados desde que salió cada cambio; los demás, con «Actualizar formato». Los concluidos nunca cambian.
VALUATION_LAYOUT_REFRESH="all"
