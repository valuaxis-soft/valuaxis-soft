# Desarrollo local. Producción usa /opt/apps/valuos/secrets/production.env en el servidor.

# Base local de compose.dev.yml
DATABASE_URL="postgresql://valuaxis:valuaxis@localhost:5432/valuaxis_dev?schema=public"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# development: no envía correos, los registra en consola. ses: Amazon SES.
EMAIL_PROVIDER="development"
SES_FROM_EMAIL=""
SES_FROM_NAME=""
TEST_EMAIL_TO=""

# local: escribe en public/ (solo desarrollo). s3: bucket privado con URLs firmadas.
STORAGE_DRIVER="local"
MAX_UPLOAD_SIZE_MB="10"
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_S3_ENDPOINT=""

# Google OAuth. El callback debe ser APP_URL + /api/auth/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Solo para pnpm auth:create-admin. Bórralas después de crear al administrador.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME=""
INITIAL_ORGANIZATION_NAME=""
INITIAL_ADMIN_EMAIL_VERIFIED="false"
