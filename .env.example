# Desarrollo local. Producción usa /opt/apps/valuos/secrets/production.env en el servidor.

# Base local de compose.dev.yml
DATABASE_URL="postgresql://valuaxis:valuaxis@localhost:5432/valuaxis_dev?schema=public"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# development: no envía correos, los registra en consola. ses: Amazon SES.
EMAIL_PROVIDER="development"
SES_FROM_EMAIL=""
SES_FROM_NAME=""
TEST_EMAIL_TO=""
AWS_SES_REGION=""
AWS_SES_ACCESS_KEY_ID=""
AWS_SES_SECRET_ACCESS_KEY=""

# local: escribe en public/ (solo desarrollo). s3: bucket privado con URLs firmadas.
STORAGE_DRIVER="local"
MAX_UPLOAD_SIZE_MB="10"
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_S3_ENDPOINT=""
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""

# Compatibilidad temporal con la configuración AWS anterior durante la migración.
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Google OAuth. El callback debe ser APP_URL + /api/auth/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Solo para pnpm auth:create-admin. Bórralas después de crear al administrador.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME=""
INITIAL_ORGANIZATION_NAME=""
INITIAL_ADMIN_EMAIL_VERIFIED="false"

# Chromium para generar el dictamen en PDF en el servidor. La imagen de producción usa /usr/bin/chromium.
# En Mac: "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
CHROMIUM_PATH=""
# Dirección con que ese Chromium abre la app; por omisión http://127.0.0.1:$PORT.
INTERNAL_APP_URL=""

# Cobro con Stripe (opcional). Sin STRIPE_SECRET_KEY la app funciona igual y la página
# "Plan y facturación" avisa que los pagos no están habilitados. Ver docs/COBRO.md.
# En producción usa una clave restringida (rk_live_...) con los permisos de docs/COBRO.md.
STRIPE_SECRET_KEY=""
# Secreto de firma del endpoint /api/stripe/webhook (whsec_...). Sin él, el webhook rechaza todo.
STRIPE_WEBHOOK_SECRET=""
# Configuración propia del portal de clientes (bpc_...); la imprime pnpm stripe:sync.
STRIPE_PORTAL_CONFIGURATION=""
# No se usa: el pago es en la página de Stripe (Checkout por redirección), sin Stripe.js en el navegador.
# STRIPE_PUBLISHABLE_KEY=""

# Asistencia con IA (opcional): "Pegar anuncio" y "Redactar borrador". Sin ANTHROPIC_API_KEY la app
# funciona igual, los botones no aparecen y las rutas responden "no habilitado". Ver docs/IA.md.
ANTHROPIC_API_KEY=""
# Modelos; vacíos usan los predeterminados (claude-haiku-4-5 para extraer, claude-opus-5-5 para redactar).
AI_EXTRACTION_MODEL=""
AI_DRAFTING_MODEL=""
